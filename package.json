{
  "name": "oscd-editor-supervision",
  "description": "Plugin for editing GOOSE and SMV supervision logical nodes of IEC 61850 SCL files for OpenSCD",
  "license": "Apache-2.0",
  "author": "Daniel Mulholland",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danyill/oscd-supervision.git"
  },
  "main": "dist/oscd-editor-supervision.js",
  "module": "dist/oscd-editor-supervision.js",
  "exports": {
    ".": "./dist/oscd-editor-supervision.js"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "!dist/testing",
    "!dist/demo"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "start": "oscd start",
    "start:bundle": "oscd start-bundle",
    "build": "npm run clean && oscd build --no-clean",
    "bundle": "npm run clean && oscd bundle --no-clean",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "test:visual": "oscd test --visual",
    "test:update": "oscd test --update",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "oscd install-hooks",
    "pretest": "npm run clean"
  },
  "dependencies": {
    "@material/mwc-button": "^0.27.0",
    "@material/mwc-checkbox": "^0.27.0",
    "@material/mwc-dialog": "^0.27.0",
    "@material/mwc-formfield": "^0.27.0",
    "@material/mwc-icon": "^0.27.0",
    "@material/mwc-icon-button": "^0.27.0",
    "@material/mwc-icon-button-toggle": "^0.27.0",
    "@material/mwc-list": "^0.27.0",
    "@material/mwc-menu": "^0.27.0",
    "@material/mwc-textfield": "^0.27.0",
    "@openenergytools/scl-lib": "^0.12.1",
    "@openscd/open-scd-core": "^0.0.2",
    "@openscd/oscd-filtered-list": "^1.1.1",
    "lit": "^3.1.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@omicronenergy/oscd-tooling": "0.0.8",
    "@open-wc/testing": "^4.0.0",
    "@types/node": "^20.19.43",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-visual-regression": "^0.10.0",
    "rollup-plugin-copy": "^3.5.0"
  }
}
